{
  "name": "leadgenius",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p ${PORT:-3200}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "check:first-run": "tsx scripts/check-first-run.mts",
    "seed:key": "tsx prisma/seed-key.ts",
    "check:contract": "tsx scripts/check-contract.mts",
    "check:llms-full": "tsx scripts/build-llms-full.mts --check",
    "build:llms-full": "tsx scripts/build-llms-full.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.8.0",
    "@slack/web-api": "^7.19.0",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.4",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.0",
    "twilio": "^5.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
