# LeadGenius - Multichannel Outreach Engine
# SQLite by default so the product runs with zero infrastructure.
# For Postgres: change `provider` in prisma/schema.prisma to "postgresql" and
# point this at your database. Nothing else needs to change.
# Prisma 7 resolves this relative to the project root (v6 resolved it against
# the schema directory); ./prisma/dev.db keeps the file v6 created.
DATABASE_URL="file:./prisma/dev.db"

# Redis for BullMQ queues
REDIS_URL="redis://localhost:6379"

# This app's own origin. The billing routes use it to refuse a return_url that
# would send a customer somewhere else after they have entered card details.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3200

# Required before /api/webhooks/email|linkedin|whatsapp will accept anything.
# The sender computes x-inbound-signature = hex(HMAC-SHA256(secret,
# `${x-inbound-timestamp}.${rawBody}`)); see src/lib/inbound-webhooks.ts.
# Unset, those endpoints answer 503 instead of trusting the request.
# INBOUND_WEBHOOK_SIGNING_SECRET=

# Optional: Email provider (for production)
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# POSTMARK_API_KEY=

# Optional: Twilio for WhatsApp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Optional: LinkedIn API
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Email delivery for verification + password reset. Unset, links are written to
# the server log and the UI says so instead of claiming a message was sent.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Abetworks <noreply@yourdomain.com>
